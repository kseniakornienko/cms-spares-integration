    {
      "parameters": {
        "jsCode": "const columns = [\n  'spareCode',\n  'spareName',\n  'spareDescription',\n  'spareType',\n  'spareStatus',\n  'price',\n  'quantity',\n  'updatedAt',\n];\n\nfunction escapeCsv(value) {\n  if (value === null || value === undefined) {\n    return '';\n  }\n\n  const text = String(value);\n\n  if (/[;\"\\r\\n]/.test(text)) {\n    return `\"${text.replace(/\"/g, '\"\"')}\"`;\n  }\n\n  return text;\n}\n\nconst csv = $input\n  .all()\n  .map(item =>\n    columns\n      .map(column => escapeCsv(item.json[column]))\n      .join(';')\n  )\n  .join('\\r\\n');\n\nreturn [\n  {\n    json: {\n      csv,\n      rowCount: $input.all().length,\n    },\n  },\n];"
      },
